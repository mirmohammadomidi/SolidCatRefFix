<Window x:Class="SolidRefrenceRename.WPFUI.BatchProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SolidRefrenceRename.WPFUI"
        xmlns:viewModels="clr-namespace:SolidRefrenceRename.WPFUI.ViewModel"
        xmlns:local1="clr-namespace:SolidRefrenceRename.WPFUI.Lib"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:SolidFixViewModel}"
        Title="CATProduct Batch Processing" Height="650" Width="1024">
    <Window.Resources>
        <local1:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="3"/>

            <RowDefinition Height="150"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Grid.Row="1" Padding="10 5 10 0" Content="Options:"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="75"/>
            </Grid.RowDefinitions>
            <Label Padding="10 5 10 0" Grid.Row="0" Grid.Column="0" Content="Base address pattern to replace: (empty=use db addresses)"/>
            <Label Padding="10 5 10 0" Grid.Row="0" Grid.Column="1" Content="Pattern replacement: "/>
            <Label Padding="10 5 10 0" Grid.Row="0" Grid.Column="2" Content="Just include these new file names to fix: (empty=all) "/>
            <TextBox Height="35" Padding="3" Margin="5" x:Name="txbBasePattern" Grid.Row="1" Grid.Column="0" Text="\\192.168.42.91\ifs\ifs\path\AFP"/>
            <TextBox Height="35" Padding="3" Margin="5" x:Name="txbReplace" Grid.Row="1" Grid.Column="1" Text="\\192.168.1.4\bcybersql\ifs\path" />
            <TextBox Padding="3" Margin="5" x:Name="txbJustInclude" TextWrapping="Wrap" Grid.Row="1" Grid.Column="2"
                     Text=""/>
        </Grid>
        <StackPanel Grid.Column="0" Grid.Row="4"  Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <Button
                 IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" Height="30"
                Padding="3" Margin="10 0 0 0" Content="Start Fixing CATProducts (Batch)" Click="Button_StartBatchFixing_Click"/>
                <Label Content="Software: CATIA" VerticalAlignment="Center" Margin="20 0 0 0"/>
                <Label Content="Files: CATProduct only (batch)" VerticalAlignment="Center" Margin="10 0 0 0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="120">
                <TextBlock  Text="Site: " VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbSites" Width="110" Height="30"  Margin="10 0 0 0" SelectedIndex="0" IsEditable="True">
                    <ComboBoxItem Content="All Sites" />
                    <ComboBoxItem Content="A"/>
                    <ComboBoxItem Content="B" />
                    <ComboBoxItem Content="M" />
                </ComboBox>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="0" Grid.Row="5"  Orientation="Horizontal">
            <Label Padding="10 5 10 0" Content="Number Of Parts:"/>
            <Label Padding="10 5 10 0" x:Name="lblNumberOfParts"/>
            <Label Padding="10 5 10 0" Content="Number Of Assemblies:"/>
            <Label Padding="10 5 10 0"  x:Name="lblNumberOfAssemblies"/>
        </StackPanel>
        <StackPanel  Grid.Row="6" Orientation="Horizontal">
            <Label Padding="10 5 10 0" Content="Current Item:"/>
            <Label x:Name="lblCurrent" Padding="10 5 10 0" Content="-"/>
        </StackPanel>
        <ProgressBar Grid.Row="7"  x:Name="prBar"/>
        <!-- LIVE LOG: always visible, shows the most recent activity -->
        <ListBox x:Name="lstLiveLog" Grid.Row="8"
                 ItemsSource="{Binding LiveLog}"
                 FontFamily="Consolas" FontSize="11" Margin="5 2 5 2"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 VirtualizingPanel.ScrollUnit="Pixel"/>
        <!-- ERROR GRID -->
        <TabControl Grid.Row="9" SelectedItem="tiErrors">
            <TabItem x:Name="tiErrors" Header="Errors">
                <DataGrid Grid.Row="8"
          ItemsSource="{Binding Errors}"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="200" />
                        <DataGridTextColumn Header="Assembly" Binding="{Binding AssemblyFile}" Width="2*" />
                        <DataGridTextColumn Header="Part"     Binding="{Binding PartName}"     Width="2*" />
                        <DataGridTextColumn Header="Message"  Binding="{Binding Message}"      Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Logs">
                <TextBox x:Name="txbLog" ></TextBox>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
