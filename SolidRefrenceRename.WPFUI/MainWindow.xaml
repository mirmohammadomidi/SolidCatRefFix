<Window x:Class="SolidRefrenceRename.WPFUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SolidRefrenceRename.WPFUI"
        mc:Ignorable="d"
         xmlns:viewModels="clr-namespace:SolidRefrenceRename.WPFUI.ViewModel" xmlns:local1="clr-namespace:SolidRefrenceRename.WPFUI.Lib"
        d:DataContext="{d:DesignInstance Type=viewModels:SolidFixViewModel}"
        Title="MainWindow" Height="650" Width="1024">
    <Window.Resources>
        <local1:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="3"/>

            <RowDefinition Height="150"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Grid.Row="1" Padding="10 5 10 0" Content="Options:"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="75"/>
            </Grid.RowDefinitions>
            <Label Padding="10 5 10 0" Grid.Row="0" Grid.Column="0" Content="Base address pattern to replace: (empty=use db addresses)"/>
            <Label Padding="10 5 10 0" Grid.Row="0" Grid.Column="1" Content="Pattern replacement: "/>
            <Label Padding="10 5 10 0" Grid.Row="0" Grid.Column="2" Content="Just include these new file names to fix: (empty=all) "/>
            <TextBox Height="35" Padding="3" Margin="5" x:Name="txbBasePattern" Grid.Row="1" Grid.Column="0" Text=""/>
            <TextBox Height="35" Padding="3" Margin="5" x:Name="txbReplace" Grid.Row="1" Grid.Column="1" Text="" />
            <TextBox Padding="3" Margin="5" x:Name="txbJustInclude" TextWrapping="Wrap" Grid.Row="1" Grid.Column="2" 
                     Text="E1031F-F20432V1-1-R1-1.CATDrawing"/>
        </Grid>
        <StackPanel Grid.Column="0" Grid.Row="4"  Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <Button 
                 IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" Height="30"
                Padding="3" Margin="10 0 0 0" Content="Start Fixing Solidwork Files" Click="Button_FixSolid_Click"/>
                <Button 
                
                     IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" Height="30"
                    Padding="3" Margin="10 0 0 0" Content="Start Fixing CATIA Files" Click="Button_FixCATIA_Click"/>
                <Button                
              IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" Height="30"
             Padding="3" Margin="10 0 0 0" Content="Start Fixing CATIA Test Files" Click="Button_Test_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="120">
                <TextBlock  Text="Target File Address: " VerticalAlignment="Center"/>
                <TextBox x:Name="txbCatiaTargetFile" Width="350" Margin="10 0 0 0"  Height="30" Text="C:\catia\E1031F-F20435V1-1-R1-1.CATDrawing"/>
                <TextBlock x:Name="txbParts" Text="Parts addresses: " Margin="10 0 0 0" VerticalAlignment="Center"/>
                <TextBox x:Name="txbSourceFiles" MinWidth="200"  TextWrapping="Wrap" Margin="10 0 0 0"  Height="100" Text="F20435V1.CATPart;C:\CatiaParts\E1031F-F20435V1-2-R1-1.CATPart,"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="0" Grid.Row="5"  Orientation="Horizontal">
            <Label Padding="10 5 10 0" Content="Number Of Parts:"/>
            <Label Padding="10 5 10 0" x:Name="lblNumberOfParts"/>
            <Label Padding="10 5 10 0" Content="Number Of Drawings:"/>
            <Label Padding="10 5 10 0" x:Name="lblNumberOfDrawings"/>
            <Label Padding="10 5 10 0" Content="Number Of Assemblies:"/>
            <Label Padding="10 5 10 0"  x:Name="lblNumberOfAssemblies"/>
        </StackPanel>
        <StackPanel  Grid.Row="6" Orientation="Horizontal">
            <Label Padding="10 5 10 0" Content="Current Item:"/>
            <Label x:Name="lblCurrent" Padding="10 5 10 0" Content="-"/>
        </StackPanel>
        <ProgressBar Grid.Row="7"  x:Name="prBar"/>
        <!-- ERROR GRID -->
        <TabControl Grid.Row="8" SelectedItem="tiErrors">
            <TabItem x:Name="tiErrors" Header="Errors">
                <DataGrid Grid.Row="8"
          ItemsSource="{Binding Errors}"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="200" />
                        <DataGridTextColumn Header="Assembly" Binding="{Binding AssemblyFile}" Width="2*" />
                        <DataGridTextColumn Header="Part"     Binding="{Binding PartName}"     Width="2*" />
                        <DataGridTextColumn Header="Message"  Binding="{Binding Message}"      Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Logs">
                <TextBox x:Name="txbLog" ></TextBox>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
