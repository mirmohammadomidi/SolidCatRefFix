<Window x:Class="SolidRefrenceRename.WPFUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SolidRefrenceRename.WPFUI"
        mc:Ignorable="d"
        Title="Solid Reference Rename Tools" Height="240" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Content="Select a tool:" Padding="10 5 10 0" VerticalAlignment="Center"/>
        <Button Grid.Row="1" Content="Reference Fixing Tool (CATIA / SolidWorks)"
                FontSize="14" Padding="5" Margin="20 5 20 5" Click="Button_OpenReferenceFixTool_Click"/>
        <Button Grid.Row="2" Content="CATProduct Batch Processing Tool"
                FontSize="14" Padding="5" Margin="20 5 20 5" Click="Button_OpenBatchTool_Click"/>
    </Grid>
</Window>
